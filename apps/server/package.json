{
  "name": "@blitz/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "tsc --noEmit -p tsconfig.json && node --import tsx --test $(find src -name '*.test.ts' -print)",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@blitz/shared": "0.0.0",
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.6",
    "node-mocks-http": "^1.17.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
